<?xml version="1.0" encoding="UTF-8"?>
<!--
  Базовый профиль логирования для продакшена и разработки.
  Логируем в консоль и в файл с ротацией, чтобы быстро получать трассировки ошибок.
-->
<configuration scan="true" scanPeriod="30 seconds">
    <!-- Общий паттерн с отметкой профиля и потока. -->
    <property name="FILE_LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>
    <property name="LOG_FILE" value="${LOG_FILE_PATH:-logs/filmorate.log}"/>

    <!-- Консольный аппендер: удобно в docker-compose и Kubernetes логах. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Файловый аппендер с ротацией по размеру, чтобы не занимать диск. -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- Максимум 10 файлов по 10 МБ, хранится история за неделю. -->
            <fileNamePattern>${LOG_FILE}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Уровни по умолчанию: инфо, но оставляем возможность поднять уровень через переменные. -->
    <root level="${ROOT_LOG_LEVEL:-INFO}">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
